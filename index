<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Website</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#2a2230; --muted:#6f6578; --bg:#fbf8fc; --card:#ffffff;
    --accent:#7a3b8f; --line:#e6dcec; --danger:#b3261e; --ok:#1f7a4d;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:'Nunito Sans',system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6}
  h1,h2,h3{font-family:'Fraunces',Georgia,serif;line-height:1.15;margin:0}
  a{color:inherit}
  .wrap{max-width:1100px;margin:0 auto;padding:0 20px}
  header.top{display:flex;justify-content:space-between;align-items:center;padding:18px 0}
  header.top .brand{font-family:'Fraunces',serif;font-weight:800;font-size:1.3rem;text-decoration:none}
  header.top nav a{margin-left:18px;text-decoration:none;font-weight:600;color:var(--muted)}
  header.top nav a:hover{color:var(--accent)}
  .hero{padding:56px 0 40px}
  .hero h1{font-size:clamp(2.2rem,6vw,4rem);font-weight:800;max-width:14ch}
  .hero p{max-width:48ch;color:var(--muted);font-size:1.1rem;margin:18px 0 26px}
  .btn{display:inline-block;border:0;cursor:pointer;background:var(--accent);color:#fff;font:700 1rem 'Nunito Sans',sans-serif;padding:12px 24px;border-radius:999px;text-decoration:none}
  .btn:hover{filter:brightness(1.1)}
  .btn:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #c28bd6;outline-offset:2px}
  .btn.ghost{background:transparent;color:var(--accent);border:2px solid var(--accent)}
  .btn.small{padding:6px 14px;font-size:.85rem}
  .btn.danger{background:var(--danger)}
  .btn[disabled]{opacity:.6;cursor:wait}
  section{padding:40px 0}
  section h2{font-size:2rem;margin-bottom:20px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}
  figure.item{margin:0;background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden}
  figure.item img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;cursor:zoom-in}
  figure.item figcaption{padding:10px 14px;font-weight:600}
  .empty{color:var(--muted);padding:24px;border:2px dashed var(--line);border-radius:14px;text-align:center}
  form.card,.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px}
  label{display:block;font-weight:700;margin:14px 0 6px}
  input[type=text],input[type=email],input[type=password],textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;font:inherit;background:#fff}
  textarea{min-height:130px;resize:vertical}
  .note{margin-top:12px;font-weight:600}
  .note.ok{color:var(--ok)} .note.err{color:var(--danger)}
  footer{padding:30px 0 50px;color:var(--muted);text-align:center;border-top:1px solid var(--line);margin-top:30px}
  .hidden{display:none!important}
  #lightbox{position:fixed;inset:0;background:rgba(20,10,25,.88);display:flex;align-items:center;justify-content:center;z-index:50;padding:20px}
  #lightbox img{max-width:100%;max-height:100%;border-radius:10px}
  .admin-bar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:20px}
  .msg{border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:12px;background:#fff}
  .msg .meta{color:var(--muted);font-size:.85rem;margin-bottom:6px}
  .msg .row{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
  .msg p{margin:6px 0 0;white-space:pre-wrap;word-break:break-word}
  .thumb-actions{padding:0 14px 12px}
  .tabs{display:flex;gap:8px;margin-bottom:18px}
  .tabs button{border:1px solid var(--line);background:#fff;padding:8px 18px;border-radius:999px;font:700 .95rem 'Nunito Sans',sans-serif;cursor:pointer}
  .tabs button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
  .setup{background:#fff4e5;border:1px solid #f0c27b;border-radius:12px;padding:18px;margin:30px 0}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<div class="wrap">

  <!-- PUBLIC SITE -->
  <div id="publicView">
    <header class="top">
      <a class="brand" href="#" id="brandName">My Website</a>
      <nav><a href="#gallery">Gallery</a><a href="#contact">Contact</a></nav>
    </header>

    <div class="hero">
      <h1 id="heroTitle">Welcome to my work</h1>
      <p id="heroText">Browse my latest pictures below.</p>
      <a class="btn" href="#contact">Send a message</a>
      <a class="btn ghost" href="#gallery">See gallery</a>
    </div>

    <section id="gallery">
      <h2>Gallery</h2>
      <div id="galleryGrid" class="grid"></div>
    </section>

    <section id="contact">
      <h2>Contact me</h2>
      <form class="card" id="contactForm" style="max-width:560px">
        <label for="cName">Your name</label>
        <input type="text" id="cName" required maxlength="80">
        <label for="cEmail">Your email or phone</label>
        <input type="text" id="cEmail" required maxlength="120">
        <label for="cMsg">Message</label>
        <textarea id="cMsg" required maxlength="2000"></textarea>
        <div style="margin-top:18px"><button class="btn" type="submit" id="cBtn">Send message</button></div>
        <div id="cNote" class="note" role="status"></div>
      </form>
    </section>

    <footer>
      <span id="footerText">© My Website</span>
      &nbsp;·&nbsp; <a href="#admin" style="color:var(--muted)">Owner login</a>
    </footer>
  </div>

  <!-- ADMIN -->
  <div id="adminView" class="hidden">
    <header class="top">
      <a class="brand" href="#">← Back to website</a>
      <span></span>
    </header>

    <div id="loginBox" class="panel hidden" style="max-width:420px;margin:30px auto">
      <h2 style="font-size:1.6rem">Owner login</h2>
      <form id="loginForm">
        <label for="lEmail">Email</label>
        <input type="email" id="lEmail" required autocomplete="username">
        <label for="lPass">Password</label>
        <input type="password" id="lPass" required autocomplete="current-password">
        <div style="margin-top:18px"><button class="btn" type="submit">Log in</button></div>
        <div id="lNote" class="note err" role="alert"></div>
      </form>
    </div>

    <div id="dash" class="hidden">
      <div class="admin-bar">
        <h2 style="font-size:1.8rem">Dashboard</h2>
        <button class="btn ghost small" id="logoutBtn">Log out</button>
      </div>
      <div class="tabs">
        <button id="tabPics" class="active">Pictures</button>
        <button id="tabMsgs">Messages <span id="msgCount"></span></button>
      </div>

      <div id="picsPane">
        <div class="panel" style="margin-bottom:24px;max-width:560px">
          <h3 style="font-size:1.2rem">Upload a picture</h3>
          <label for="upFile">Choose picture(s)</label>
          <input type="file" id="upFile" accept="image/*" multiple>
          <label for="upCaption">Caption (optional)</label>
          <input type="text" id="upCaption" maxlength="100">
          <div style="margin-top:16px"><button class="btn" id="upBtn">Upload</button></div>
          <div id="upNote" class="note" role="status"></div>
        </div>
        <div id="adminGrid" class="grid"></div>
      </div>

      <div id="msgsPane" class="hidden">
        <div id="msgList"></div>
      </div>
    </div>
  </div>

  <div id="setupWarn" class="setup hidden">
    <strong>Setup needed:</strong> Open <code>index.html</code>, find <code>firebaseConfig</code> and paste your Firebase details there.
  </div>

</div>

<div id="lightbox" class="hidden"><img alt=""></div>

<script type="module">
/* =====================================================================
   1) YAHAN APNI DETAILS LIKHEIN
   ===================================================================== */
const SITE = {
  name: "My Website",
  heroTitle: "Welcome to my work",
  heroText: "Browse my latest pictures below, and send me a message if you would like to work together.",
  footer: "© My Website"
};

// Firebase config yahan paste karein
const firebaseConfig = {
  apiKey: "PASTE_HERE",
  authDomain: "PASTE_HERE",
  projectId: "PASTE_HERE",
  storageBucket: "PASTE_HERE",
  messagingSenderId: "PASTE_HERE",
  appId: "PASTE_HERE"
};
/* ===================================================================== */

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, deleteDoc, doc, query, orderBy, serverTimestamp }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

document.title = SITE.name;
$("brandName").textContent = SITE.name;
$("heroTitle").textContent = SITE.heroTitle;
$("heroText").textContent = SITE.heroText;
$("footerText").textContent = SITE.footer;

const configured = !firebaseConfig.apiKey.includes("PASTE_HERE");
let db, auth;
if (configured) {
  const app = initializeApp(firebaseConfig);
  db = getFirestore(app);
  auth = getAuth(app);
} else {
  $("setupWarn").classList.remove("hidden");
}

/* routing */
function route() {
  const isAdmin = location.hash === "#admin";
  $("publicView").classList.toggle("hidden", isAdmin);
  $("adminView").classList.toggle("hidden", !isAdmin);
  if (isAdmin) window.scrollTo(0,0);
}
window.addEventListener("hashchange", route);
route();

/* public gallery */
async function loadGallery() {
  const grid = $("galleryGrid");
  if (!configured) { grid.innerHTML = '<div class="empty">Gallery will appear here after setup.</div>'; return; }
  try {
    const snap = await getDocs(query(collection(db, "gallery"), orderBy("createdAt", "desc")));
    if (snap.empty) { grid.innerHTML = '<div class="empty">No pictures yet. Please check back soon.</div>'; return; }
    grid.innerHTML = snap.docs.map(d => {
      const x = d.data();
      return `<figure class="item"><img loading="lazy" src="${x.image}" alt="${esc(x.caption || 'Picture')}">${x.caption ? `<figcaption>${esc(x.caption)}</figcaption>` : ''}</figure>`;
    }).join("");
  } catch (e) {
    console.error(e);
    grid.innerHTML = '<div class="empty">Could not load pictures. Please refresh the page.</div>';
  }
}
loadGallery();

/* lightbox */
document.addEventListener("click", e => {
  if (e.target.matches("figure.item img")) {
    $("lightbox").querySelector("img").src = e.target.src;
    $("lightbox").classList.remove("hidden");
  } else if (e.target.closest("#lightbox")) {
    $("lightbox").classList.add("hidden");
  }
});
document.addEventListener("keydown", e => { if (e.key === "Escape") $("lightbox").classList.add("hidden"); });

/* contact form */
$("contactForm").addEventListener("submit", async e => {
  e.preventDefault();
  const note = $("cNote"), btn = $("cBtn");
  if (!configured) { note.className = "note err"; note.textContent = "Website is not set up yet."; return; }
  btn.disabled = true; note.className = "note"; note.textContent = "Sending...";
  try {
    await addDoc(collection(db, "messages"), {
      name: $("cName").value.trim(),
      contact: $("cEmail").value.trim(),
      message: $("cMsg").value.trim(),
      createdAt: serverTimestamp()
    });
    $("contactForm").reset();
    note.className = "note ok"; note.textContent = "Thank you! Your message has been sent.";
  } catch (err) {
    console.error(err);
    note.className = "note err"; note.textContent = "Message could not be sent. Please try again.";
  }
  btn.disabled = false;
});

/* admin auth */
if (configured) {
  onAuthStateChanged(auth, user => {
    $("loginBox").classList.toggle("hidden", !!user);
    $("dash").classList.toggle("hidden", !user);
    if (user) { loadAdminPics(); loadMessages(); }
  });
}
$("loginForm").addEventListener("submit", async e => {
  e.preventDefault();
  $("lNote").textContent = "";
  if (!configured) { $("lNote").textContent = "Website is not set up yet."; return; }
  try {
    await signInWithEmailAndPassword(auth, $("lEmail").value.trim(), $("lPass").value);
    $("loginForm").reset();
  } catch (err) {
    $("lNote").textContent = "Wrong email or password.";
  }
});
$("logoutBtn").addEventListener("click", () => signOut(auth));

/* tabs */
function showTab(which) {
  $("picsPane").classList.toggle("hidden", which !== "pics");
  $("msgsPane").classList.toggle("hidden", which !== "msgs");
  $("tabPics").classList.toggle("active", which === "pics");
  $("tabMsgs").classList.toggle("active", which === "msgs");
}
$("tabPics").onclick = () => showTab("pics");
$("tabMsgs").onclick = () => showTab("msgs");

/* admin pictures */
function shrinkImage(file, maxSide = 1100, quality = 0.78) {
  return new Promise((resolve, reject) => {
    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      let { width: w, height: h } = img;
      const scale = Math.min(1, maxSide / Math.max(w, h));
      w = Math.round(w * scale); h = Math.round(h * scale);
      const c = document.createElement("canvas");
      c.width = w; c.height = h;
      c.getContext("2d").drawImage(img, 0, 0, w, h);
      URL.revokeObjectURL(url);
      let data = c.toDataURL("image/jpeg", quality);
      if (data.length > 950000) data = c.toDataURL("image/jpeg", 0.55);
      data.length > 980000 ? reject(new Error("Picture too large")) : resolve(data);
    };
    img.onerror = () => reject(new Error("Not a valid picture"));
    img.src = url;
  });
}

$("upBtn").addEventListener("click", async () => {
  const files = [...$("upFile").files];
  const note = $("upNote");
  if (!files.length) { note.className = "note err"; note.textContent = "Please choose a picture first."; return; }
  $("upBtn").disabled = true; note.className = "note";
  let done = 0;
  try {
    for (const f of files) {
      note.textContent = `Uploading ${done + 1} of ${files.length}...`;
      const image = await shrinkImage(f);
      await addDoc(collection(db, "gallery"), {
        image, caption: $("upCaption").value.trim(), createdAt: serverTimestamp()
      });
      done++;
    }
    $("upFile").value = ""; $("upCaption").value = "";
    note.className = "note ok"; note.textContent = `${done} picture(s) uploaded.`;
    loadAdminPics(); loadGallery();
  } catch (err) {
    console.error(err);
    note.className = "note err";
    note.textContent = "Upload failed: " + (err.message || "please try again") + (done ? ` (${done} uploaded)` : "");
  }
  $("upBtn").disabled = false;
});

async function loadAdminPics() {
  const grid = $("adminGrid");
  const snap = await getDocs(query(collection(db, "gallery"), orderBy("createdAt", "desc")));
  if (snap.empty) { grid.innerHTML = '<div class="empty">No pictures uploaded yet.</div>'; return; }
  grid.innerHTML = snap.docs.map(d => {
    const x = d.data();
    return `<figure class="item"><img src="${x.image}" alt="">${x.caption ? `<figcaption>${esc(x.caption)}</figcaption>` : ''}
      <div class="thumb-actions"><button class="btn danger small" data-del-pic="${d.id}">Delete</button></div></figure>`;
  }).join("");
}
$("adminGrid").addEventListener("click", async e => {
  const id = e.target.dataset.delPic;
  if (!id) return;
  if (!confirm("Delete this picture?")) return;
  await deleteDoc(doc(db, "gallery", id));
  loadAdminPics(); loadGallery();
});

/* admin messages */
async function loadMessages() {
  const list = $("msgList");
  const snap = await getDocs(query(collection(db, "messages"), orderBy("createdAt", "desc")));
  $("msgCount").textContent = snap.size ? `(${snap.size})` : "";
  if (snap.empty) { list.innerHTML = '<div class="empty">No messages yet.</div>'; return; }
  list.innerHTML = snap.docs.map(d => {
    const x = d.data();
    const when = x.createdAt ? x.createdAt.toDate().toLocaleString() : "";
    return `<div class="msg"><div class="row"><div>
      <strong>${esc(x.name)}</strong>
      <div class="meta">${esc(x.contact)} &nbsp;·&nbsp; ${when}</div></div>
      <button class="btn danger small" data-del-msg="${d.id}">Delete</button></div>
      <p>${esc(x.message)}</p></div>`;
  }).join("");
}
$("msgList").addEventListener("click", async e => {
  const id = e.target.dataset.delMsg;
  if (!id) return;
  if (!confirm("Delete this message?")) return;
  await deleteDoc(doc(db, "messages", id));
  loadMessages();
});
</script>
</body>
</html>
